    "def analyze_sentiment_subjectivity_for_plotting(df, label_order):\n",
    "    sentiment_data_plot = {}\n",
    "    for label in label_order:\n",
    "        label_df = df[df['label'].astype(str) == label]['text'].dropna()\n",
    "        polarities = []\n",
    "        subjectivities = []\n",
    "        for text in label_df:\n",
    "            blob = TextBlob(text)\n",
    "            polarities.append(blob.sentiment.polarity)\n",
    "            subjectivities.append(blob.sentiment.subjectivity)\n",
    "        sentiment_data_plot[label] = {'polarity': polarities, 'subjectivity': subjectivities}\n",
    "    return sentiment_data_plot"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 94,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
